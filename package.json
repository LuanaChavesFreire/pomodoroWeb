{
  "name": "pomodoro-web",
  "version": "1.0.0",
  "description": "PomodoroWeb",
  "scripts": {
    "lint": "node ./node_modules/eslint/bin/eslint.js app/*.js",
    "test": "node ./node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node ./node_modules/jest/bin/jest.js --coverage --coverageReporters=text-summary --passWithNoTests"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "app/**/*.js"
    ]
  }
}